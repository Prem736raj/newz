rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSavedCase(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 300 &&
             data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 1000 &&
             data.fullReport is string && data.fullReport.size() >= 3 && data.fullReport.size() <= 10000 &&
             data.stateName is string && data.stateName.size() >= 2 && data.stateName.size() <= 100 &&
             data.districtName is string && data.districtName.size() >= 2 && data.districtName.size() <= 100 &&
             data.cityName is string && data.cityName.size() >= 2 && data.cityName.size() <= 100 &&
             data.mlaName is string && data.mlaName.size() >= 2 && data.mlaName.size() <= 200 &&
             data.mpName is string && data.mpName.size() >= 2 && data.mpName.size() <= 200 &&
             data.victimCategory is string && data.victimCategory.size() >= 2 && data.victimCategory.size() <= 100 &&
             data.crimeCategory is string && data.crimeCategory.size() >= 2 && data.crimeCategory.size() <= 100 &&
             data.caseStage is string && data.caseStage.size() >= 2 && data.caseStage.size() <= 100 &&
             data.incidentDateLabel is string && data.incidentDateLabel.size() >= 2 && data.incidentDateLabel.size() <= 100 &&
             (!('personalNotes' in data) || data.personalNotes == null || (data.personalNotes is string && data.personalNotes.size() <= 2000)) &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2000)) &&
             (!('videoUrl' in data) || data.videoUrl == null || (data.videoUrl is string && data.videoUrl.size() <= 2000)) &&
             (!('mediaCaption' in data) || data.mediaCaption == null || (data.mediaCaption is string && data.mediaCaption.size() <= 1000)) &&
             (!('visibility' in data) || data.visibility == null || (data.visibility is string && (data.visibility == 'PRIVATE' || data.visibility == 'PUBLIC'))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCaseFollowUp(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.caseId is string && data.caseId.size() >= 1 && data.caseId.size() <= 128 &&
             data.caseTitle is string && data.caseTitle.size() >= 2 && data.caseTitle.size() <= 300 &&
             data.updateDateLabel is string && data.updateDateLabel.size() >= 2 && data.updateDateLabel.size() <= 100 &&
             data.stageBadge is string && data.stageBadge.size() >= 2 && data.stageBadge.size() <= 100 &&
             data.headline is string && data.headline.size() >= 3 && data.headline.size() <= 300 &&
             data.details is string && data.details.size() >= 3 && data.details.size() <= 5000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isVerifiedEditor() {
      return isSignedIn() && request.auth.token.editor == true;
    }

    function isValidCorrectionRequest(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.caseId is string && data.caseId.size() >= 1 && data.caseId.size() <= 128 &&
             data.issueType is string && data.issueType.size() >= 2 && data.issueType.size() <= 100 &&
             data.details is string && data.details.size() >= 3 && data.details.size() <= 5000 &&
             data.status is string && data.status in ['PENDING_EDITORIAL_REVIEW', 'SUBMITTED_PENDING_REVIEW'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId}/saved_cases/{caseId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(caseId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(caseId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'summary', 'fullReport',
                         'stateName', 'districtName', 'cityName',
                         'mlaName', 'mpName', 'victimCategory', 'crimeCategory',
                         'caseStage', 'incidentDateLabel', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'summary', 'fullReport',
                         'stateName', 'districtName', 'cityName',
                         'mlaName', 'mpName', 'victimCategory', 'crimeCategory',
                         'caseStage', 'incidentDateLabel', 'personalNotes',
                         'imageUrl', 'videoUrl', 'mediaCaption', 'visibility',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidSavedCase(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(caseId) &&
                       isValidSavedCase(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'summary', 'fullReport',
                         'stateName', 'districtName', 'cityName',
                         'mlaName', 'mpName', 'victimCategory', 'crimeCategory',
                         'caseStage', 'incidentDateLabel', 'personalNotes',
                         'imageUrl', 'videoUrl', 'mediaCaption', 'visibility',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(caseId);
    }

    // P0 Security Gate: Regular clients CANNOT directly publish to /public_dispatches.
    // Only server-side admin SDK or accounts with custom token 'editor == true' can publish,
    // and 'personalNotes' is strictly forbidden in public records.
    match /public_dispatches/{caseId} {
      allow get: if isSignedIn() && isValidId(caseId) && existing().visibility == 'PUBLIC';
      allow list: if isSignedIn() && resource.data.visibility == 'PUBLIC';

      allow create: if isVerifiedEditor() &&
                       isValidId(caseId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().visibility == 'PUBLIC' &&
                       !('personalNotes' in incoming()) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'summary', 'fullReport',
                         'stateName', 'districtName', 'cityName',
                         'mlaName', 'mpName', 'victimCategory', 'crimeCategory',
                         'caseStage', 'incidentDateLabel', 'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'summary', 'fullReport',
                         'stateName', 'districtName', 'cityName',
                         'mlaName', 'mpName', 'victimCategory', 'crimeCategory',
                         'caseStage', 'incidentDateLabel',
                         'imageUrl', 'videoUrl', 'mediaCaption', 'visibility',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidSavedCase(incoming());

      allow update: if isVerifiedEditor() &&
                       isValidId(caseId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().visibility == 'PUBLIC' &&
                       !('personalNotes' in incoming()) &&
                       isValidSavedCase(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'summary', 'fullReport',
                         'stateName', 'districtName', 'cityName',
                         'mlaName', 'mpName', 'victimCategory', 'crimeCategory',
                         'caseStage', 'incidentDateLabel',
                         'imageUrl', 'videoUrl', 'mediaCaption', 'visibility',
                         'updatedAt'
                       ]);

      allow delete: if isVerifiedEditor() && isValidId(caseId);
    }

    match /users/{userId}/case_updates/{updateId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(updateId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(updateId) &&
                       incoming().keys().hasAll([
                         'userId', 'caseId', 'caseTitle', 'updateDateLabel',
                         'stageBadge', 'headline', 'details', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'caseId', 'caseTitle', 'updateDateLabel',
                         'stageBadge', 'headline', 'details', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCaseFollowUp(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(updateId) &&
                       isValidCaseFollowUp(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().caseId == existing().caseId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'caseTitle', 'updateDateLabel', 'stageBadge',
                         'headline', 'details', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(updateId);
    }

    match /users/{userId}/correction_requests/{requestId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(requestId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidId(requestId) &&
                       incoming().keys().hasAll([
                         'userId', 'caseId', 'issueType', 'details', 'status', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'caseId', 'issueType', 'details', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCorrectionRequest(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(requestId);
    }
  }
}
