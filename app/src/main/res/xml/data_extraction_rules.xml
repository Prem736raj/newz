<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Private notes and saved dossiers must not move to an unexpected cloud/device. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
