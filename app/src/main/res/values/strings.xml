    <string name="safety_title">Safety, Helplines &amp; Legal Rights</string>
    <string name="safety_subtitle">Verified emergency support numbers, statutory reporting guides, and public-safety resources.</string>
    <string name="safety_tab_emergency">Emergency Support</string>
    <string name="safety_tab_rights">Know Your Rights</string>
    <string name="safety_tab_civic">Safety &amp; Representatives</string>
    <string name="safety_helpline_notice">All helplines below are official toll-free or statutory government numbers operated by MHA, MWCD, and the National Commission for Women (NCW).</string>
    <string name="safety_official_source_format">Official Source: Govt. of India (%1$s)</string>
    <string name="safety_call_btn">Call</string>
    <string name="safety_legal_notice_title">Public Legal Information Notice</string>
    <string name="safety_legal_notice_body">The summaries below provide general awareness of statutory protections under the Bharatiya Nagarik Suraksha Sanhita (BNSS), Bharatiya Nyaya Sanhita (BNS), and POCSO Act. They do not constitute personalized legal counsel. For free legal aid, contact NALSA Helpline 15100.</string>
    <string name="safety_statutory_ref_format">Statutory Reference: %1$s</string>
    <string name="safety_portals_title">Official Government Reporting Portals</string>
    <string name="safety_portal_ncw_title">National Commission for Women (NCW)</string>
    <string name="safety_portal_ncw_desc">Online complaint registration &amp; 24x7 women safety cell</string>
    <string name="safety_portal_cyber_title">National Cyber Crime Reporting Portal</string>
    <string name="safety_portal_cyber_desc">Report online harassment, morphing, blackmail, or stalking (Helpline 1930)</string>
    <string name="safety_portal_ncpcr_title">NCPCR POCSO e-Box (Child Protection)</string>
    <string name="safety_portal_ncpcr_desc">Confidential reporting of offences against children and school safety lapses</string>
    <string name="safety_standards_title">School, Campus &amp; Online Safety Standards</string>
    <string name="safety_bullet_1_title">School &amp; Classroom Access Control</string>
    <string name="safety_bullet_1_body">Under NCPCR School Safety Guidelines, schools must verify all visitors at perimeter gates, prohibit unauthorized weapons or tools on campus, and maintain functional CCTV in corridors.</string>
    <string name="safety_bullet_2_title">University &amp; Workplace Internal Committees (POSH)</string>
    <string name="safety_bullet_2_body">Every higher-education institution and workplace with 10+ employees is legally required to maintain an Internal Complaints Committee (ICC) and display contact details prominently.</string>
    <string name="safety_bullet_3_title">Digital &amp; Cyber Evidence Preservation</string>
    <string name="safety_bullet_3_body">In cases of online threats or stalking, preserve screenshots with visible URLs/timestamps and report immediately via 1930 or cybercrime.gov.in before blocking accounts.</string>
