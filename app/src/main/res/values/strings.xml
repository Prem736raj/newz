    <string name="auth_investigative_desk">PUBLIC INTEREST JOURNALISM &amp; CASE ARCHIVE</string>
    <string name="auth_platform_description">An India-focused journalism and case-follow-up platform covering safety issues, investigations, and court proceedings affecting women, girls, and teenagers.</string>
